# 本机 Chrome 或 Chromium 浏览器可执行文件路径，不配置时使用 Playwright 默认浏览器
PLAYWRIGHT_BROWSER_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# 是否使用无头浏览器模式
# true: 使用无头浏览器模式
# false: 可以看见浏览器窗口
# 默认: true
PLAYWRIGHT_HEADLESS=true

# 打开抖音聊天页后是否暂停后续步骤
# true: 暂停，按回车键后继续执行
# false: 不暂停
# 默认: false
PAUSE_AFTER_PAGE_OPEN=false

# 发送完成后是否自动关闭浏览器
# true: 自动关闭浏览器
# false: 按回车键后关闭浏览器
# 默认: true
AUTO_CLOSE=true

# 发送一言时是否携带出处
# true: 携带出处
# false: 只发送正文
# 默认: true
YIYAN_INCLUDE_SOURCE=true

# 要发送消息的会话昵称，必须是一整行 JSON 字符串数组
DOUYIN_TARGET_NAMES='["暮邵落白"]'

# 要发送消息的抖音号，必须是一整行 JSON 字符串数组
# 抖音号解析依赖抖音内部接口，可能失效，建议优先配置 DOUYIN_TARGET_NAMES
# DOUYIN_TARGET_NAMES 和 DOUYIN_TARGET_IDS 至少配置一个
DOUYIN_TARGET_IDS='["xinggong62112311"]'

# 抖音 Cookie，获取方式见 README
DOUYIN_COOKIE='[{"domain":".douyin.com","expirationDate":1800175766.87008,"hostOnly":false,"httpOnly":false,"name":"UIFID","path":"/","sameSite":"no_restriction","secure":true,"session":false,"storeId":null,"value":"替换成真实 Cookie 值"}]'
